VITE_API_BASE_URL=http://localhost:8000

# Optional: public support address shown on the Help page to signed-out visitors.
# VITE_SUPPORT_EMAIL=support@example.com

# Optional: Google OAuth client ID (same as the backend's GOOGLE_CLIENT_ID).
# Unset hides the "Continue with Google" button.
# VITE_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
